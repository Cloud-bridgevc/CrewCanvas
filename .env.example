# Data source: "memory" (seeded demo data, no DB needed) or "postgres"
DATA_SOURCE=memory
DATABASE_URL=postgres://crewcanvas:crewcanvas@localhost:5432/crewcanvas

# AWS
AWS_REGION=us-east-1
S3_EVIDENCE_BUCKET=crewcanvas-evidence-dev

# Amazon Bedrock (narrative summaries + recommendation wording only — never readiness decisions)
BEDROCK_ENABLED=false
BEDROCK_MODEL_ID=anthropic.claude-opus-5-5

# HubSpot private app token (demo requests -> contacts/companies/deals)
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PIPELINE_ID=default
HUBSPOT_DEALSTAGE_ID=appointmentscheduled
